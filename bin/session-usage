#!/usr/bin/env bash
set -euo pipefail
command -v python3 >/dev/null 2>&1 || { printf 'session-usage: не найден python3\n' >&2; exit 2; }
exec python3 - "$@" <<'PY'
import argparse
import json
import os
from pathlib import Path
import re
import sys


def fail(reason):
    print(f"session-usage: {reason}", file=sys.stderr)
    sys.exit(1)


parser = argparse.ArgumentParser(description="Расход токенов одной сессии")
parser.add_argument("--agent", choices=("codex", "claude"))
parser.add_argument("--session")
args = parser.parse_args()
def session_path(agent, session):
    if not session:
        variable = "CODEX_SESSION_ID" if agent == "codex" else "CLAUDE_CODE_SESSION_ID"
        fail(f"не найдена переменная {variable}; укажите --session")
    if not re.fullmatch(r"[A-Za-z0-9_-]+", session):
        fail("недопустимый id сессии")
    if agent == "codex":
        root = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
        pattern = f"sessions/*/*/*/rollout-*-{session}.jsonl"
    else:
        root = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
        pattern = f"projects/*/{session}.jsonl"
    paths = list(root.glob(pattern))
    if len(paths) != 1:
        fail(f"файл сессии {session}: найдено {len(paths)}, ожидался один")
    return paths[0]


agent = args.agent
sessions = {a: os.environ.get(var) for a, var in
            (("codex", "CODEX_SESSION_ID"), ("claude", "CLAUDE_CODE_SESSION_ID"))}
try:
    if not agent:
        present = [a for a in sessions if sessions[a]]
        if len(present) == 2:
            modified = {a: session_path(a, args.session or sessions[a]).stat().st_mtime_ns
                        for a in present}
            if modified["codex"] == modified["claude"]:
                fail("журналы изменены одновременно; укажите --agent")
            agent = max(modified, key=modified.get)
            print(f"session-usage: выбрана {agent} сессия {args.session or sessions[agent]}: "
                  "её журнал изменён позже", file=sys.stderr)
        elif len(present) == 1:
            agent = present[0]
        else:
            fail("не найдена единственная переменная сессии; укажите --agent и --session")
    session = args.session or sessions[agent]
    path = session_path(agent, session)
except OSError as error:
    fail(f"не удалось найти журнал сессии ({type(error).__name__})")


def counts(usage, fields):
    if not isinstance(usage, dict) or not all(k in usage for k in ("input_tokens", "output_tokens")):
        fail("не найдены обязательные поля расхода")
    values = [0 if usage.get(k) is None else usage[k] for k in fields]
    if any(type(v) is not int or v < 0 for v in values):
        fail("некорректные значения расхода")
    return values


last = None
messages = {}
try:
    with path.open(encoding="utf-8") as stream:
        for line in stream:
            if not line.strip():
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                # A writer may not yet have finished the last physical line.
                if not line.endswith("\n"):
                    break
                raise
            payload = record.get("payload") or {}
            if agent == "codex":
                usage = None
                if record.get("type") == "token_usage_record":
                    usage = payload.get("thread_token_usage")
                elif record.get("type") == "event_msg" and payload.get("type") == "token_count":
                    usage = (payload.get("info") or {}).get("total_token_usage")
                if usage is not None:
                    last = counts(usage, ("input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"))
            elif record.get("type") == "assistant":
                message = record.get("message") or {}
                if message.get("usage") is not None:
                    key = ("message", message["id"]) if message.get("id") else ("request", record.get("requestId"))
                    if not key[1]:
                        fail("у ответа с расходом не найден message.id или requestId")
                    messages[key] = counts(message["usage"], ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))
except (OSError, ValueError, TypeError, AttributeError) as error:
    fail(f"не удалось прочитать данные сессии ({type(error).__name__})")
if agent == "codex":
    if last is None:
        fail("не найдены данные расхода сессии")
    inp, cached, out, reasoning = last
    details = f"вход {inp} (из кэша {cached}), выход {out} (из них reasoning {reasoning})"
else:
    if not messages:
        fail("не найдены данные расхода сессии")
    inp, read, creation, out = map(sum, zip(*messages.values()))
    details = f"вход {inp}, кэш-чтение {read}, кэш-запись {creation}, выход {out}"
print(f"Расход: {agent} сессия {session} — {details}")
PY
